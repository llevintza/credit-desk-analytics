{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/bundle-budget.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:tooling && ng test",
    "test:tooling": "node --test --experimental-test-coverage --test-coverage-include='scripts/**/*.mjs' --test-coverage-include='eslint-rules/**/*.js' --test-coverage-exclude='**/*.test.mjs' --test-coverage-lines=80 --test-coverage-branches=80 scripts/bundle-budget.test.mjs eslint-rules/no-unmanaged-subscribe.test.mjs",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/inter": "5.3.0",
    "ag-grid-angular": "36.2.0",
    "ag-grid-community": "36.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}

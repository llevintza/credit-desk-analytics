# Copy to .env for local runs (.env is gitignored). Never commit real values (AGENTS.md).
# Generate the local Postgres password once:  openssl rand -hex 16
POSTGRES_PASSWORD=
# Built from the password above; quoted because the connection string contains semicolons.
DATABASE_URL="Host=localhost;Port=5432;Database=creditdesk;Username=desk;Password=${POSTGRES_PASSWORD}"
# Any source may be left empty to fall back to DATABASE_URL (README §5.1).
ConnectionStrings__Core=
ConnectionStrings__Market=
ConnectionStrings__Surveillance=
ConnectionStrings__Pricing=
ConnectionStrings__Reference=
ConnectionStrings__App=
# Optional: Npgsql Maximum Pool Size per distinct connection string (1–100, default 20; anything else falls back to 20).
# Replaces any Maximum Pool Size already in a connection string (README §13.1).
DB_MAX_POOL_SIZE=
SEED=42
SEED_SCALE=1.0
MAINTENANCE_MODE=false
RATE_LIMIT_PER_USER_PER_MIN=60
RATE_LIMIT_GLOBAL_CONCURRENCY=8
# Optional (defaults shown, ADR-0014): RATE_LIMIT_PER_USER_BURST=60, RATE_LIMIT_LOGIN_PER_IP_PER_MIN=5, RATE_LIMIT_GLOBAL_QUEUE=32
# Optional (defaults in ADR-0005): per-user in-flight requests (1) and queue (8); exports at once (2); export deadline, s (60).
RATE_LIMIT_PER_USER_CONCURRENCY=
RATE_LIMIT_PER_USER_QUEUE=
# Optional (defaults in ADR-0005): per-user insights source reads in flight (5) and queue (15), their own partition.
RATE_LIMIT_PER_USER_INSIGHTS_CONCURRENCY=
RATE_LIMIT_PER_USER_INSIGHTS_QUEUE=
EXPORT_GLOBAL_SLOTS=
EXPORT_TIMEOUT_SECONDS=
EXPORT_MAX_ROWS=
# Optional (defaults in ADR-0015): P6 intraday marks. Tick ms (1000), stream lifetime s (300, the max), bonds marked (100),
# streams per user (2) and in total (16), overlay totals window s (15).
MARKS_TICK_MS=
MARKS_STREAM_SECONDS=
MARKS_MAX_BONDS=
MARKS_STREAMS_PER_USER=
MARKS_STREAMS_GLOBAL=
MARKS_TOTALS_SECONDS=
# Optional: seconds the refresh token swapped last still gets the current pair, e.g. after a reload aborted the refresh (default 30; clamped to 120) (ADR-0024).
AUTH_REFRESH_REUSE_GRACE_SECONDS=
# Swagger UI + /openapi (admin only). On by default in Development; elsewhere only when exactly true.
SWAGGER_ENABLED=
# Optional: in-memory response cache, MB (default 64, at most 96: ADR-0014); audit insert interval, s (default 30).
POSITIONS_CACHE_MB=
AUDIT_FLUSH_SECONDS=
# Optional: days to keep audit rows (default 90; whole days 1-36500); purged at most every 24 h, after an audit insert or by the idle timer (ADR-0022).
AUDIT_RETENTION_DAYS=
# Optional: minutes between idle-timer checks for a due audit purge (default 60; whole minutes 1-1440). A check that isn't due never touches the database.
AUDIT_PURGE_CHECK_MINUTES=
# Optional: P3 insights fan-out, grids read in parallel per request (default 4; 1-16) and pooled connections across the process (default 10; 1-100) (ADR-0012).
INSIGHTS_PARALLELISM=
INSIGHTS_MAX_CONNECTIONS=
# Optional, dev and e2e only: exactly true honours the X-Debug-Delay-Ms header (<= 5000 ms) and the Performance Lab's X-Lab-Encoding (ADR-0028) outside Development. Never set it in production.
DEV_FAULT_INJECTION=
# Optional: JSON array of {email, password, role, expires, portfolios?}; portfolios become the account's grants (ADR-0021 E2).
DEMO_ACCOUNTS_JSON=
# Optional: all (default, every account sees every portfolio) | grants (per-user grants, ADR-0021). Anything else fails startup.
ENTITLEMENTS_MODE=
ASPNETCORE_ENVIRONMENT=Development

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(**/secrets/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(!**/.env.example)",
      "Edit(**/secrets/**)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git push * +main)",
      "Bash(git push * +main *)",
      "Bash(git push *--force)",
      "Bash(git push *--force *)",
      "Bash(git push * -f*)",
      "Bash(git push -f*)",
      "Bash(git push *--no-verify*)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(gh api *merge*)",
      "Bash(gh api *git/refs*)",
      "Bash(gh -R *pr merge*)",
      "Bash(gh --repo *pr merge*)",
      "Bash(gh pr -R* merge*)",
      "Bash(gh pr --repo* merge*)",
      "Bash(git push *--force-*)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo *deploy-key*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *protection*)",
      "Bash(gh api *default_branch*)",
      "Bash(gh api *environments*)",
      "Bash(gh api *secrets*)",
      "Bash(gh api *variables*)",
      "Bash(gh api *dispatches*)",
      "Bash(gh api *rename*)",
      "Bash(gh api *keys*)",
      "Bash(gh api *hooks*)",
      "Bash(gh api *collaborators*)",
      "Bash(gh api *actions/*)",
      "Bash(gh api graphql *mutation*)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh workflow *run *)",
      "Bash(gh workflow *enable *)",
      "Bash(gh workflow *disable *)",
      "Bash(gh run *rerun*)",
      "Bash(gh run *cancel*)",
      "Bash(gh run *delete*)",
      "Bash(*curl*)",
      "Bash(*wget*)",
      "Bash(gh -*)",
      "Bash(gh pr -*)",
      "Bash(gh issue -*)",
      "Bash(gh repo -*)",
      "Bash(gh release -*)",
      "Bash(gh label -*)",
      "Bash(gh secret -*)",
      "Bash(gh variable -*)",
      "Bash(gh workflow -*)",
      "Bash(gh run -*)",
      "Bash(gh ruleset -*)",
      "Bash(gh cache -*)",
      "Bash(gh alias -*)",
      "Bash(gh api -*)",
      "Bash(git push)"
    ],
    "ask": [
      "Edit(./**/AGENTS.md)",
      "Edit(./**/CLAUDE.md)",
      "Edit(./.claude/**)",
      "Edit(./.cursor/**)",
      "Edit(./.github/**)",
      "Edit(./docs/agents/**)",
      "Edit(./scripts/agents/**)"
    ],
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(npm run lint)",
      "Bash(npm test *)",
      "Bash(git status)",
      "Bash(git diff *)"
    ]
  }
}

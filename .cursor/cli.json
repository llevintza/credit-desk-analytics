{
  "permissions": {
    "allow": [
      "Shell(dotnet:build *)",
      "Shell(dotnet:test *)",
      "Shell(npm:run lint)",
      "Shell(npm:test *)",
      "Shell(git:status)",
      "Shell(git:diff *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/secrets/**)",
      "Shell(git:push * main)",
      "Shell(git:push * main *)",
      "Shell(git:push *:main)",
      "Shell(git:push *:main *)",
      "Shell(git:push *refs/heads/main)",
      "Shell(git:push *refs/heads/main *)",
      "Shell(git:push * +main)",
      "Shell(git:push * +main *)",
      "Shell(git:push *--force)",
      "Shell(git:push *--force *)",
      "Shell(git:push * -f*)",
      "Shell(git:push -f*)",
      "Shell(git:push *--no-verify*)",
      "Shell(gh:pr merge)",
      "Shell(gh:pr merge *)",
      "Shell(gh:api *merge*)",
      "Shell(gh:api *git/refs*)",
      "Shell(gh:-R *pr merge*)",
      "Shell(gh:--repo *pr merge*)",
      "Shell(gh:pr -R* merge*)",
      "Shell(gh:pr --repo* merge*)",
      "Shell(git:push *--force-*)",
      "Shell(gh:repo edit *)",
      "Shell(gh:repo delete *)",
      "Shell(gh:repo rename *)",
      "Shell(gh:repo archive *)",
      "Shell(gh:repo *deploy-key*)",
      "Shell(gh:api *rulesets*)",
      "Shell(gh:api *protection*)",
      "Shell(gh:api *default_branch*)",
      "Shell(gh:api *environments*)",
      "Shell(gh:api *secrets*)",
      "Shell(gh:api *variables*)",
      "Shell(gh:api *dispatches*)",
      "Shell(gh:api *rename*)",
      "Shell(gh:api *keys*)",
      "Shell(gh:api *hooks*)",
      "Shell(gh:api *collaborators*)",
      "Shell(gh:api *actions/*)",
      "Shell(gh:api graphql *mutation*)",
      "Shell(gh:secret *)",
      "Shell(gh:variable *)",
      "Shell(gh:workflow *run *)",
      "Shell(gh:workflow *enable *)",
      "Shell(gh:workflow *disable *)",
      "Shell(gh:run *rerun*)",
      "Shell(gh:run *cancel*)",
      "Shell(gh:run *delete*)",
      "Shell(curl)",
      "Shell(wget)",
      "Shell(gh:-*)",
      "Shell(gh:pr -*)",
      "Shell(gh:issue -*)",
      "Shell(gh:repo -*)",
      "Shell(gh:release -*)",
      "Shell(gh:label -*)",
      "Shell(gh:secret -*)",
      "Shell(gh:variable -*)",
      "Shell(gh:workflow -*)",
      "Shell(gh:run -*)",
      "Shell(gh:ruleset -*)",
      "Shell(gh:cache -*)",
      "Shell(gh:alias -*)",
      "Shell(gh:api -*)",
      "Shell(git:push * +*)",
      "Shell(git:push +*)",
      "Shell(gh:alias set*)",
      "Shell(gh:alias import*)",
      "Shell(gh:extension install*)",
      "Shell(gh:extension exec*)",
      "Shell(gh:extension -*)",
      "Shell(gh:extensions *)",
      "Shell(gh:ext *)"
    ]
  }
}

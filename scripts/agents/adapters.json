{
  "inputs": [
    "**/AGENTS.md",
    "**/CLAUDE.md",
    ".claude/**",
    ".cursor/**",
    ".cursorignore",
    ".cursorrules",
    "docs/agents/**",
    "scripts/agents/*.json",
    "scripts/agents/hooks/**",
    "README.md",
    "docs/deployment-setup.md",
    ".gitleaks.toml",
    ".github/workflows/*.y*ml",
    ".mcp.json",
    ".gitignore",
    "perf/coverage-baseline.json"
  ],
  "enforcement": [
    ".github/**",
    "scripts/agents/**",
    "perf/coverage-*",
    "tests/testconfig.json",
    ".gitmodules",
    "**/.claude/**",
    ".grok/**",
    "**/CLAUDE.local.md",
    ".claudeignore",
    ".cursorrules"
  ],
  "outputs": [
    {
      "path": ".cursor/cli.json",
      "sources": [
        ".claude/settings.json",
        "scripts/agents/permission-map.json"
      ],
      "render": "cursor-cli"
    },
    {
      "path": ".cursor/hooks.json",
      "sources": [
        ".claude/settings.json"
      ],
      "render": "cursor-hooks"
    },
    {
      "path": ".cursorignore",
      "sources": [
        ".claude/settings.json"
      ],
      "render": "cursorignore"
    },
    {
      "path": "scripts/agents/hooks/secret-patterns.txt",
      "sources": [
        ".gitleaks.toml"
      ],
      "render": "secret-patterns"
    }
  ],
  "cursorAreaRules": false
}
